{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rioX432/ai-dev-templates/capabilities/schema.json",
  "title": "ai-dev capability manifest",
  "description": "Fine-grained software engineering capabilities a resolver can load one at a time. Standalone entries are listed so they can be classified, never so a resolver can load them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "capabilities"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "repository"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "repository": {"type": "string", "pattern": "^https://"}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "summary",
        "scope",
        "entrypoint",
        "resources",
        "authority",
        "hosts",
        "contract_version",
        "content_hash"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
        "kind": {
          "description": "capability: reusable HOW. policy: optional rules a repository opts into. standalone: a wrapper or tool for direct Claude/Codex use that a resolver must not load.",
          "enum": ["capability", "policy", "standalone"]
        },
        "summary": {"type": "string", "minLength": 10},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "produces", "excludes"],
          "properties": {
            "unit": {"enum": ["change", "issue", "repository", "flow", "topic", "project", "session"]},
            "produces": {
              "enum": [
                "report",
                "decision-matrix",
                "plan",
                "code-change",
                "findings",
                "issue",
                "pull-request",
                "docs",
                "guidance",
                "project-files",
                "orchestration"
              ]
            },
            "excludes": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true}
          }
        },
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.md$"},
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": {"enum": ["skill", "rule", "agent", "policy", "doc", "script"]},
              "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace", "external", "spawns_agents", "user_interaction"],
          "properties": {
            "workspace": {"enum": ["none", "read", "write"]},
            "external": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "web.read",
                  "browser.interact",
                  "device.interact",
                  "codex.read-only",
                  "github.read",
                  "github.issue.write",
                  "github.pr.write",
                  "github.merge",
                  "git.push",
                  "project.write"
                ]
              }
            },
            "spawns_agents": {"type": "boolean"},
            "user_interaction": {"enum": ["none", "optional", "required"]}
          }
        },
        "hosts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claude", "codex"],
          "properties": {
            "claude": {"enum": ["native", "unsupported"]},
            "codex": {"enum": ["rendered", "native", "partial", "unsupported"]}
          }
        },
        "composes": {
          "description": "Capabilities this entry may invoke. A capability or policy must not compose a standalone entry.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "standalone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "reason"],
          "properties": {
            "role": {"enum": ["composition-wrapper", "control-plane", "host-adapter", "distribution"]},
            "reason": {"type": "string", "minLength": 10}
          }
        },
        "contract_version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
