{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(java -version)",
      "Bash(kotlin -version)",
      "Bash(node --version)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(ruby --version)",
      "Bash(swift --version)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh issue create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(!.env.example)",
      "Edit(!.env.example)",
      "Read(!.env.sample)",
      "Edit(!.env.sample)",
      "Read(!.env.template)",
      "Edit(!.env.template)",
      "Read(**/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Edit(*.pbxproj)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
